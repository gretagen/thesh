# theshrc - Thesh shell configuration
# Loaded at startup for every user via /etc/theshrc
# Loaded for user at ~/.theshrc

# Aliases

alias ll='ls -l'
alias la='ls -la'
alias h='history'
alias cls='clear'

# Styling
# `layout` (or `looks`) is the prompt template. Tokens:
#   $USER $HOSTNAME $SEPERATOR $RIGHTWALL $LEFTWALL $PATH $CURSOR $SPACER
# ($DIR/$PWD alias $PATH; $SPACER is one literal space; other text is kept)

layout = "$RIGHTWALL $SPACER $USER $SPACER $SEPERATOR $SPACER $HOSTNAME $SPACER $LEFTWALL $SPACER $PATH $SPACER $CURSOR"

rightwallstyle = '['
leftwallstyle = ']'
seperatorstyle = '|'

# any symbol can be a cursor; '' for none
cursorstyle = '$'

# colors
# presets: black red green yellow blue purple cyan white grey pink,
#          bright-<color>
#   default : no color change, strictly the terminal default foreground
#   none    : no color code at all

rightwall-color = 'default'
leftwall-color = 'default'
seperator-color = 'default'
hostname-color = 'default'
user-color = 'default'
path-color = 'default'
cursor-color = 'default'
guesser-color = 'grey'

# textcolor : general text color, used for literal text and for any
#             element without its own color (default: none)
# textcolor = 'default'

# opacity (percentages, quoted or bare: '100%' or 65)
# below 100% the color is blended toward black and emitted as a 256-color
# code; only has an effect on elements that have a color set

rightwall-opacity = '100%'
leftwall-opacity = '100%'
seperator-opacity = '100%'
hostname-opacity = '100%'
user-opacity = '100%'
path-opacity = '100%'
cursor-opacity = '100%'
guesser-opacity = '65%'

# typing
# hybrid    : allows lowercase and uppercase (default)
# lowercase : lowercase only

typing = 'hybrid'

# guesser
# guesses the command you're typing from history

guesser = 'yes'

# corrector
# active   : immediately corrects the command
# passive  : tells you "no such command, did you mean 'cmd'?" (default)
# consent  : asks before correcting your command
# inactive : disables correction

corrector = 'passive'

# shortcuts (key bindings)
# canonical form: bind = <combo> = <action>   (wm-style)
# the bare form without `bind = ` still works: ALT + T = exec('top')
# left side: modifiers CTRL/ALT/SUPER (WIN/WINDOWS/META also work) and
#   SHIFT, joined with '+', plus a key: a letter/digit/symbol, or a name
#   such as ENTER TAB UP DOWN LEFT RIGHT HOME END PGUP PGDN BACKSPACE
#   DELETE ESC, or F1..F24. A modifier is optional: F11 = ... binds the
#   plain key. SHIFT works for arrows, Home/End, PgUp/PgDn, F-keys and
#   Tab — plain letters can't carry shift (terminals don't distinguish
#   'A' from Shift+a), so `SHIFT + A` is rejected with a warning.
# actions: exec('cmd') run a command; ask(label) appends prompt input to it
#   (prompts cancelled with ESC/Ctrl+C/Ctrl+D);
#          copy / paste the line clipboard; close exits the shell.

bind = ALT + T = exec('top')

bind = CTRL + ALT + V = paste
bind = CTRL + ALT + C = copy
bind = CTRL + C = close

# advanced bind: prompts for a path, then runs micro <path>
# (note: CTRL+M shares its byte with Enter and CTRL+H with Backspace —
#  their binds fire only on an EMPTY line, so Enter/Backspace always
#  win while you type. ALT+M keeps the mnemonic.)
bind = ALT + M = "exec('micro') ask(path?)"

# prompts for an action, then runs zeta <action>
bind = CTRL + Z = "exec('zeta')  ask(action?)"

# Super (Windows) key + arrow, plain function keys, shift combos:
# bind = SUPER + UP  = exec('echo super up')
# bind = F11         = exec('something')
# bind = ALT + F5    = exec('reload')
# bind = SHIFT + TAB = exec('echo other window')
# bind = SHIFT + LEFT = exec('echo select mode')

# history
#   history      = 'yes' records new commands and saves them on exit;
#                  'no' stops recording (the saved file is left alone)
#   historylimit = keep only the last N commands (any value; default 500)

history = 'yes'
historylimit = '30'

# animations — how typed characters appear on screen:
#   animation = matrix     random letters scramble into the one you typed
#   animation = newcomer   the letter rides in from the right
#   animation = placement  pieces snap in from every side, like legos
#   animation = spinner    a / - \ | spinner before the letter lands
#   animation = none       (default) instant, plain typing
# The character is committed to the line the moment you press the key, so
# typing fast just cuts the animation short — nothing is ever lost.

animation = matrix

# multiplexer (built-in tiling with tmux-style separators)
# thin │ ─ lines with ┬ ┴ ├ ┤ ┼ junctions separate the panes and
# nothing is drawn on the terminal edges; the focused pane's
# separators take the active colour:
multiplexer-active-color = 'blue'
multiplexer-inactive-color = 'default'
# settings:
#   multiplexer = 'yes'               allow splitting ('no' disables it
#                                     and tears down an active mux)
#   multiplexer-window-limit = 'inf'  max panes ('inf' or a number)
#   multiplexer-style = 'crosshair'   separator style
# splits act on the focused pane when bound; typed, they split the pane
# you type in (inside a pane that starts that pane's own nested mux):
#   bind = ALT + V = split-window-vertical 50
#   bind = ALT + H = split-window-horizontal 50
# moving focus: Ctrl+arrows work out of the box, or bind the arrows:
#   bind = ALT + R-ARROW = move-to-right-window   (L-/U-/D-ARROW too)
# window management:
#   bind = CTRL + Q = kill-curent-window   (kill-current-window too)
#   bind = CTRL + K = kill-all-windows
#     first press clears the child panes; killing the shell's own
#     pane parks the shell and moves focus to its sibling (refused
#     only when it's the last pane) — kill-all-windows then empties
#     the mux and brings the shell's prompt back.
#     binds also fire while htop/an editor runs in a pane.
# commands: split-window-vertical/horizontal [N], close-pane,
#   kill-curent-window, kill-all-windows, move-to-*-window,
#   focus-left/right/up/down/next/prev, panes
# PgUp/PgDn scroll whichever pane has focus — even while a program
#   runs in it; any other key returns to live.
# mouse: the wheel scrolls whichever pane it is over; a click goes
#   to the program in the pane under the pointer — translated to
#   that pane's coordinates, only if it asked for mouse tracking —
#   and never changes focus (move with Ctrl+arrows or your binds).
#   Clicks on a divider or on scrollback are ignored.
#   Reporting is on only while the mux runs.
# splitting never loses your session: the typed line, aliases, cwd
#   and history stay in memory; each pane starts fresh at the top
#   of its rectangle, tmux-style.
# pane children run with $THESH_MUX=1 in the environment.
multiplexer = 'yes'
multiplexer-window-limit = 'inf'
multiplexer-style = crosshair

# movement & scrolling
#   movespeed   = letters the cursor advances per left/right press (default 1)
#   scrollspeed = history entries per up/down press (default 1)
#   amplify     = hold an arrow key down and each repeat advances
#                 step × amplify — 'yes' = ×2, 'no' (or 1) = off (default 2).
#                 The first press is always the base speed.

movespeed = '1'
scrollspeed = '1'
amplify = '2'

# presets
#   presets          : list presets and apply one (the shell asks whether
#                      to make it the default for system/user/both, then
#                      overwrites the rc file(s) and re-sources them)
#   savepreset       : save the current config as a preset
# presets are stored in ~/.config/thesh/presets/ (user) and
# /etc/thesh/presets (system)

echo "Welcome to thesh on Haliade OS."